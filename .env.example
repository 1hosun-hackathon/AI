# Ollama (API 키 불필요)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma4:e2b-it-qat
EMBED_MODEL=bge-m3

# true | false | omit (omit: 사고 모드가 없는 모델이라 think 필드를 보내지 않음)
LLM_THINK=false
LLM_TEMPERATURE=0
DRAFT_TEMPERATURE=0.7
LLM_NUM_CTX=8192
LLM_TIMEOUT_SEC=120
LLM_KEEP_ALIVE=30m
LLM_CONCURRENCY=1
LLM_SEED=42

PROMPT_VERSION=v4
GUARDRAIL_MAX_RETRY=1
NGRAM_N=12

AI_SIMILAR_THRESHOLD=0.80
KEEP_THRESHOLD=0.75
MIN_SENTENCE_CHARS=8

MAX_DRAFT_CHARS=3000
JOB_TTL_SEC=3600
JOB_QUEUE_MAX=20
WARMUP=true
