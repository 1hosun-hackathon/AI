# ollama | mock (mock: Ollama 없이 고정 형식의 가짜 응답. 백엔드·프론트 연동 개발용)
LLM_PROVIDER=ollama
MOCK_DELAY_SEC=0

# Ollama (API 키 불필요)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gemma4:e2b-it-qat
EMBED_MODEL=bge-m3

# true | false | omit (omit: 사고 모드가 없는 모델이라 think 필드를 보내지 않음)
LLM_THINK=false
LLM_TEMPERATURE=0
DRAFT_TEMPERATURE=0.7
LLM_NUM_CTX=8192
LLM_TIMEOUT_SEC=120
LLM_KEEP_ALIVE=30m
LLM_CONCURRENCY=1
LLM_SEED=42

PROMPT_VERSION=v5
GUARDRAIL_MAX_RETRY=1
NGRAM_N=12

AI_SIMILAR_THRESHOLD=0.80
KEEP_THRESHOLD=0.75
MIN_SENTENCE_CHARS=8

MAX_DRAFT_CHARS=3000
JOB_TTL_SEC=3600
JOB_QUEUE_MAX=20
WARMUP=true

# 외부(터널)로 공개할 때 반드시 설정. 백엔드는 모든 요청에 X-API-Key 헤더로 이 값을 보낸다.
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
