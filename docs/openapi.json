              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReferenceDraftResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ai/analyze": {
      "post": {
        "summary": "Submit Analyze",
        "operationId": "submit_analyze_ai_analyze_post",
