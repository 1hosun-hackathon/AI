              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ai/reanalyze": {
      "post": {
        "summary": "Submit Reanalyze",
        "operationId": "submit_reanalyze_ai_reanalyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReanalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreated"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ai/jobs/{job_id}": {
      "get": {
        "summary": "Get Job",
        "operationId": "get_job_ai_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ai/dependency": {
      "post": {
        "summary": "Compute Dependency",
        "operationId": "compute_dependency_ai_dependency_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DependencyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DependencyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ai/v2/ai-writing": {
      "post": {
        "tags": [
          "백엔드 명세 형식"
        ],
        "summary": "Create Ai Writing",
        "description": "2-1 훈련 생성 직후(또는 4-4 재시도 시) AI 작성 글을 만든다. 동기 호출.",
        "operationId": "create_ai_writing_ai_v2_ai_writing_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AiWritingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiWritingResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ai/v2/analyses": {
      "post": {
        "tags": [
          "백엔드 명세 형식"
        ],
        "summary": "Submit Analysis",
        "description": "3-2 초안 제출(seqNo 0) 또는 3-4 다시 검사하기(seqNo≥1)의 비교 분석을 시작한다.",
        "operationId": "submit_analysis_ai_v2_analyses_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ai/v2/analyses/{job_id}": {
      "get": {
        "tags": [
          "백엔드 명세 형식"
        ],
        "summary": "Get Analysis",
        "description": "4-1 분석 상태 폴링. SUCCESS면 result를 4-2 결과로 저장한다.",
        "operationId": "get_analysis_ai_v2_analyses__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisJob"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ai/v2/self-thought-ratio": {
      "post": {
        "tags": [
          "백엔드 명세 형식"
        ],
        "summary": "Compute Ratio",
        "description": "3-5 훈련 완료 시 자기 사고 비율·AI 의존도(%)를 계산한다. LLM 미사용, 동기 호출.",
        "operationId": "compute_ratio_ai_v2_self_thought_ratio_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RatioRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RatioResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AiWritingRequest": {
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "writingType": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Writingtype",
            "description": "글 형식. 예: 논설문"
          },
          "requirements": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requirements",
            "description": "과제 조건 문자열. 예: \"800~1,000자, 근거 2개 이상\""
          }
        },
        "type": "object",
        "required": [
          "topic"
        ],
        "title": "AiWritingRequest"
      },
      "AiWritingResponse": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content",
            "description": "4-2 aiWriting.content로 저장할 AI 작성 글"
          },
          "charCount": {
            "type": "integer",
            "title": "Charcount"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "default": []
          },
          "promptVersion": {
            "type": "string",
            "title": "Promptversion"
          },
          "model": {
            "type": "string",
            "title": "Model"
          }
        },
        "type": "object",
        "required": [
          "content",
          "charCount",
          "promptVersion",
          "model"
        ],
        "title": "AiWritingResponse"
      },
      "AnalysisAccepted": {
        "properties": {
          "jobId": {
            "type": "string",
            "title": "Jobid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "GENERATING",
              "SUCCESS",
              "FAILED"
            ],
            "title": "Status",
            "default": "PENDING"
          }
        },
        "type": "object",
        "required": [
          "jobId"
        ],
        "title": "AnalysisAccepted"
      },
      "AnalysisItem": {
        "properties": {
          "criterion": {
            "type": "string",
            "enum": [
              "THESIS",
              "EVIDENCE",
              "STRUCTURE",
              "EXPRESSION",
              "ORIGINALITY"
            ],
            "title": "Criterion"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "userSummary": {
            "type": "string",
            "title": "Usersummary"
          },
          "aiSummary": {
            "type": "string",
            "title": "Aisummary"
          },
          "comparison": {
            "type": "string",
            "title": "Comparison"
          },
          "reflectPoint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reflectpoint",
            "description": "보완 방향. 대필 검사를 통과하지 못하면 null"
          },
          "userScore": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Userscore",
            "description": "화면에는 표시하지 않음. 대시보드 집계·재검사에 사용"
          },
          "aiScore": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Aiscore"
          },
          "better": {
            "type": "string",
            "enum": [
              "user",
              "ai",
              "tie"
            ],
            "title": "Better"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceQuote"
            },
            "type": "array",
            "title": "Evidence",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "criterion",
          "label",
          "description",
          "userSummary",
          "aiSummary",
          "comparison",
          "userScore",
          "aiScore",
          "better"
        ],
        "title": "AnalysisItem"
      },
      "AnalysisJob": {
        "properties": {
          "jobId": {
            "type": "string",
            "title": "Jobid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "GENERATING",
              "SUCCESS",
              "FAILED"
            ],
            "title": "Status"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisReport"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "{\"code\", \"message\", \"retryable\"}"
          }
        },
        "type": "object",
        "required": [
          "jobId",
          "status"
        ],
        "title": "AnalysisJob",
        "description": "4-1 분석 상태. SUCCESS면 result, FAILED면 error가 채워진다."
      },
      "AnalysisReport": {
        "properties": {
          "seqNo": {
            "type": "integer",
            "title": "Seqno"
          },
          "overallSummary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Overallsummary",
            "description": "종합 리포트. 검사를 통과하지 못하면 null"
          },
          "strengths": {
            "type": "string",
            "title": "Strengths",
            "description": "강점. 여러 개면 줄바꿈으로 구분"
          },
          "improvements": {
            "type": "string",
            "title": "Improvements",
            "description": "보완할 점. 여러 개면 줄바꿈으로 구분"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/AnalysisItem"
            },
            "type": "array",
            "title": "Items",
            "description": "THESIS, EVIDENCE, STRUCTURE, EXPRESSION, ORIGINALITY 순서"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/Question"
            },
            "type": "array",
            "title": "Questions"
          },
          "reflectionReviews": {
            "items": {
              "$ref": "#/components/schemas/ReflectionReview"
            },
            "type": "array",
            "title": "Reflectionreviews",
            "description": "다시 검사(seqNo≥1)일 때 지난 reflectPoint 반영 여부",
            "default": []
          },
          "scoreDelta": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "enum": [
                "THESIS",
                "EVIDENCE",
                "STRUCTURE",
                "EXPRESSION",
                "ORIGINALITY"
              ]
            },
            "type": "object",
            "title": "Scoredelta",
            "description": "다시 검사일 때 직전 회차 대비 userScore 변화",
            "default": {}
          },
          "partial": {
            "type": "boolean",
            "title": "Partial",
            "description": "일부 항목·필드가 빠졌으면 true. 사유는 warnings",
            "default": false
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "default": []
          },
          "promptVersion": {
            "type": "string",
            "title": "Promptversion"
          },
          "model": {
            "type": "string",
            "title": "Model"
          }
        },
        "type": "object",
        "required": [
          "seqNo",
          "strengths",
          "improvements",
          "items",
          "questions",
          "promptVersion",
          "model"
        ],
        "title": "AnalysisReport",
        "description": "4-2 비교 분석 결과의 AI 부분. 다시 검사할 때 previousResult로 그대로 돌려준다."
      },
      "AnalysisRequest": {
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "writingType": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Writingtype",
            "description": "글 형식. 예: 논설문"
          },
          "requirements": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requirements",
            "description": "과제 조건 문자열. 예: \"800~1,000자, 근거 2개 이상\""
          },
          "seqNo": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Seqno",
            "description": "0이면 초안 제출(3-2), 1 이상이면 다시 검사하기(3-4)",
            "default": 0
          },
          "myWriting": {
            "$ref": "#/components/schemas/Content",
            "description": "이번에 제출한 글"
          },
          "aiWriting": {
            "$ref": "#/components/schemas/Content"
          },
          "baseline": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Content"
              },
              {
                "type": "null"
              }
            ],
            "description": "seqNo≥1일 때 필수. 최초 초안(seqNo 0)"
          },
          "previousResult": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisReport"
              },
              {
                "type": "null"
              }
            ],
            "description": "seqNo≥1일 때 필수. 직전 회차 분석 결과 그대로"
          }
        },
        "type": "object",
        "required": [
          "topic",
          "myWriting",
          "aiWriting"
        ],
        "title": "AnalysisRequest"
      },
      "AnalysisResult": {
        "properties": {
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "status": {
            "type": "string",
            "enum": [
              "done",
              "partial",
              "failed"
            ],
            "title": "Status"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ItemResult"
            },
            "type": "array",
            "title": "Items"
          },
          "overall_report": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Overall Report"
          },
          "strengths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Strengths",
            "default": []
          },
          "improvements": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Improvements",
            "default": []
          },
          "questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Questions",
            "default": []
          },
          "failed_items": {
            "items": {
              "type": "string",
              "enum": [
                "thesis",
                "evidence",
                "structure",
                "expression",
                "originality"
              ]
            },
            "type": "array",
            "title": "Failed Items",
            "default": []
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "prompt_version",
          "model",
          "status",
          "items"
        ],
        "title": "AnalysisResult"
      },
      "AnalyzeRequest": {
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "requirements": {
            "$ref": "#/components/schemas/Requirements",
            "default": {}
          },
          "user_draft": {
            "type": "string",
            "title": "User Draft"
          },
          "ai_draft": {
            "type": "string",
            "title": "Ai Draft"
          }
        },
        "type": "object",
        "required": [
          "topic",
          "user_draft",
          "ai_draft"
        ],
        "title": "AnalyzeRequest"
      },
      "Content": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "Content"
      },
      "DependencyMethod": {
        "properties": {
          "embedding_model": {
            "type": "string",
            "title": "Embedding Model"
          },
          "ai_similar_threshold": {
            "type": "number",
            "title": "Ai Similar Threshold"
          },
          "keep_threshold": {
            "type": "number",
            "title": "Keep Threshold"
          },
          "weighting": {
            "type": "string",
            "const": "chars",
            "title": "Weighting",
            "default": "chars"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "embedding_model",
          "ai_similar_threshold",
          "keep_threshold",
          "description"
        ],
        "title": "DependencyMethod"
      },
      "DependencyRequest": {
        "properties": {
